    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import sqlite3\n",
    "\n",
    "# =========================================\n",
    "# STEP 1: LOAD DATASET\n",
    "# =========================================\n",
    "\n",
    "df = pd.read_csv(r\"C:\\Users\\DELL\\Downloads\\sales_data(1).csv\")\n",
    "\n",
    "print(\"FIRST 5 RECORDS\")\n",
    "print(df.head())\n",
    "\n",
    "# =========================================\n",
    "# STEP 2: DATASET INFORMATION\n",
    "# =========================================\n",
    "\n",
    "print(\"\\nDATASET INFO\")\n",
    "df.info()\n",
    "\n",
    "print(\"\\nDATASET SHAPE\")\n",
    "print(df.shape)\n",
    "\n",
    "# =========================================\n",
    "# STEP 3: CHECK MISSING VALUES\n",
    "# =========================================\n",
    "\n",
    "print(\"\\nMISSING VALUES\")\n",
    "print(df.isnull().sum())\n",
    "\n",
    "# =========================================\n",
    "# STEP 4: REMOVE DUPLICATES\n",
    "# =========================================\n",
    "\n",
    "duplicates_before = df.shape[0]\n",
    "\n",
    "df = df.drop_duplicates()\n",
    "\n",
    "duplicates_after = df.shape[0]\n",
    "\n",
    "print(\"\\nAFTER REMOVING DUPLICATES\")\n",
    "print(df.shape)\n",
    "\n",
    "print(\"Duplicates Removed:\",\n",
    "      duplicates_before - duplicates_after)\n",
    "\n",
    "# =========================================\n",
    "# STEP 5: DESCRIPTIVE STATISTICS\n",
    "# =========================================\n",
    "\n",
    "print(\"\\nDESCRIPTIVE STATISTICS\")\n",
    "print(df.describe())\n",
    "\n",
    "# =========================================\n",
    "# STEP 6: KPI SUMMARY\n",
    "# =========================================\n",
    "\n",
    "print(\"\\nKPI SUMMARY\")\n",
    "\n",
    "total_revenue = df['Sales'].sum()\n",
    "\n",
    "total_customers = df['CustomerID'].nunique()\n",
    "\n",
    "average_sales = df['Sales'].mean()\n",
    "\n",
    "top_product = df.groupby('Product')['Sales'].sum().idxmax()\n",
    "\n",
    "top_product_revenue = df.groupby('Product')['Sales'].sum().max()\n",
    "\n",
    "top_city = df.groupby('City')['Sales'].mean().idxmax()\n",
    "\n",
    "print(\"Total Revenue:\", total_revenue)\n",
    "print(\"Total Customers:\", total_customers)\n",
    "print(\"Average Sales:\", round(average_sales, 2))\n",
    "print(\"Top Product:\", top_product)\n",
    "print(\"Top Product Revenue:\", top_product_revenue)\n",
    "print(\"Top City:\", top_city)\n",
    "\n",
    "# =========================================\n",
    "# STEP 7: UNIVARIATE ANALYSIS\n",
    "# =========================================\n",
    "\n",
    "# Histogram\n",
    "\n",
    "plt.figure(figsize=(8,5))\n",
    "plt.hist(df['Sales'],\n",
    "         bins=10,\n",
    "         color='skyblue',\n",
    "         edgecolor='black')\n",
    "\n",
    "plt.title(\"Sales Distribution\")\n",
    "plt.xlabel(\"Sales\")\n",
    "plt.ylabel(\"Frequency\")\n",
    "plt.show()\n",
    "\n",
    "# Product Count\n",
    "\n",
    "plt.figure(figsize=(8,5))\n",
    "\n",
    "df['Product'].value_counts().plot(\n",
    "    kind='bar',\n",
    "    color='orange'\n",
    ")\n",
    "\n",
    "plt.title(\"Product Count\")\n",
    "plt.xlabel(\"Product\")\n",
    "plt.ylabel(\"Count\")\n",
    "plt.show()\n",
    "\n",
    "# =========================================\n",
    "# STEP 8: MULTIVARIATE ANALYSIS\n",
    "# =========================================\n",
    "\n",
    "plt.figure(figsize=(8,5))\n",
    "\n",
    "sns.scatterplot(\n",
    "    x='Age',\n",
    "    y='Sales',\n",
    "    data=df\n",
    ")\n",
    "\n",
    "plt.title(\"Age vs Sales\")\n",
    "plt.xlabel(\"Age\")\n",
    "plt.ylabel(\"Sales\")\n",
    "plt.show()\n",
    "\n",
    "# =========================================\n",
    "# STEP 9: CORRELATION HEATMAP\n",
    "# =========================================\n",
    "\n",
    "plt.figure(figsize=(8,5))\n",
    "\n",
    "corr = df.corr(numeric_only=True)\n",
    "\n",
    "sns.heatmap(\n",
    "    corr,\n",
    "    annot=True,\n",
    "    cmap='coolwarm'\n",
    ")\n",
    "\n",
    "plt.title(\"Correlation Heatmap\")\n",
    "plt.show()\n",
    "\n",
    "# =========================================\n",
    "# STEP 10: SQL DATABASE\n",
    "# =========================================\n",
    "\n",
    "conn = sqlite3.connect(\"sales_database.db\")\n",
    "\n",
    "df.to_sql(\n",
    "    \"sales_data\",\n",
    "    conn,\n",
    "    if_exists=\"replace\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "# =========================================\n",
    "# SQL QUERY 1\n",
    "# TOP PRODUCTS BY REVENUE\n",
    "# =========================================\n",
    "\n",
    "print(\"\\nTOP 5 PRODUCTS BY REVENUE\")\n",
    "\n",
    "query1 = \"\"\"\n",
    "SELECT Product,\n",
    "SUM(Sales) AS Total_Revenue\n",
    "FROM sales_data\n",
    "GROUP BY Product\n",
    "ORDER BY Total_Revenue DESC\n",
    "LIMIT 5;\n",
    "\"\"\"\n",
    "\n",
    "result1 = pd.read_sql_query(query1, conn)\n",
    "\n",
    "print(result1)\n",
    "\n",
    "# =========================================\n",
    "# SQL QUERY 2\n",
    "# MONTHLY SALES TREND\n",
    "# =========================================\n",
    "\n",
    "print(\"\\nMONTHLY SALES TREND\")\n",
    "\n",
    "query2 = \"\"\"\n",
    "SELECT Month,\n",
    "SUM(Sales) AS Monthly_Sales\n",
    "FROM sales_data\n",
    "GROUP BY Month\n",
    "ORDER BY Month;\n",
    "\"\"\"\n",
    "\n",
    "result2 = pd.read_sql_query(query2, conn)\n",
    "\n",
    "print(result2)\n",
    "\n",
    "# =========================================\n",
    "# SQL QUERY 3\n",
    "# HIGHEST SPENDING CUSTOMERS\n",
    "# =========================================\n",
    "\n",
    "print(\"\\nHIGHEST SPENDING CUSTOMERS\")\n",
    "\n",
    "query3 = \"\"\"\n",
    "SELECT CustomerID,\n",
    "SUM(Sales) AS Total_Spent\n",
    "FROM sales_data\n",
    "GROUP BY CustomerID\n",
    "ORDER BY Total_Spent DESC\n",
    "LIMIT 10;\n",
    "\"\"\"\n",
    "\n",
    "result3 = pd.read_sql_query(query3, conn)\n",
    "\n",
    "print(result3)\n",
    "\n",
    "# =========================================\n",
    "# SQL QUERY 4\n",
    "# AVERAGE SALES BY CITY\n",
    "# =========================================\n",
    "\n",
    "print(\"\\nAVERAGE SALES BY CITY\")\n",
    "\n",
    "query4 = \"\"\"\n",
    "SELECT City,\n",
    "AVG(Sales) AS Average_Sales\n",
    "FROM sales_data\n",
    "GROUP BY City;\n",
    "\"\"\"\n",
    "\n",
    "result4 = pd.read_sql_query(query4, conn)\n",
    "\n",
    "print(result4)\n",
    "\n",
    "# =========================================\n",
    "# STEP 11: MONTHLY SALES TREND CHART\n",
    "# =========================================\n",
    "\n",
    "plt.figure(figsize=(10,5))\n",
    "\n",
    "plt.plot(\n",
    "    result2['Month'],\n",
    "    result2['Monthly_Sales'],\n",
    "    marker='o'\n",
    ")\n",
    "\n",
    "plt.title(\"Monthly Sales Trend\")\n",
    "plt.xlabel(\"Month\")\n",
    "plt.ylabel(\"Sales\")\n",
    "\n",
    "plt.grid(True)\n",
    "\n",
    "plt.show()\n",
    "\n",
    "# =========================================\n",
    "# STEP 12: PRODUCT REVENUE CHART\n",
    "# =========================================\n",
    "\n",
    "plt.figure(figsize=(8,5))\n",
    "\n",
    "plt.bar(\n",
    "    result1['Product'],\n",
    "    result1['Total_Revenue']\n",
    ")\n",
    "\n",
    "plt.title(\"Top Products by Revenue\")\n",
    "plt.xlabel(\"Product\")\n",
    "plt.ylabel(\"Revenue\")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "# =========================================\n",
    "# STEP 13: BUSINESS INSIGHTS\n",
    "# =========================================\n",
    "\n",
    "print(\"\\nBUSINESS INSIGHTS\")\n",
    "\n",
    "print(f\"1. Total Revenue Generated : ₹{total_revenue}\")\n",
    "\n",
    "print(f\"2. Total Unique Customers : {total_customers}\")\n",
    "\n",
    "print(f\"3. Average Sales : ₹{round(average_sales,2)}\")\n",
    "\n",
    "print(f\"4. Best Selling Product : {top_product}\")\n",
    "\n",
    "print(f\"5. Highest Average Sales City : {top_city}\")\n",
    "\n",
    "# =========================================\n",
    "# STEP 14: DASHBOARD KPI FILE\n",
    "# =========================================\n",
    "\n",
    "dashboard_kpi = pd.DataFrame({\n",
    "    'KPI': [\n",
    "        'Total Revenue',\n",
    "        'Total Customers',\n",
    "        'Average Sales',\n",
    "        'Top Product',\n",
    "        'Top City'\n",
    "    ],\n",
    "    'Value': [\n",
    "        total_revenue,\n",
    "        total_customers,\n",
    "        round(average_sales,2),\n",
    "        top_product,\n",
    "        top_city\n",
    "    ]\n",
    "})\n",
    "\n",
    "dashboard_kpi.to_csv(\n",
    "    \"dashboard_kpi.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "print(\"\\nDashboard KPI file saved successfully\")\n",
    "\n",
    "# =========================================\n",
    "# STEP 15: SAVE CLEANED DATASET\n",
    "# =========================================\n",
    "\n",
    "df.to_csv(\n",
    "    \"cleaned_sales_data.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "print(\"\\nCleaned Dataset Saved Successfully\")\n",
    "\n",
    "# =========================================\n",
    "# STEP 16: CLOSE DATABASE\n",
    "# =========================================\n",
    "\n",
    "conn.close()\n",
    "\n",
    "print(\"\\nTASK 2 COMPLETED SUCCESSFULLY\")"
   ]
